# BastionBank configuration (all optional; defaults shown)
BASTIONBANK_DB=bastionbank.db
# DATABASE_URL=postgres://bastionbank:bastionbank@db:5432/bastionbank   # production store seam
BASTIONBANK_JWT_SECRET=change-me-to-a-long-random-secret
